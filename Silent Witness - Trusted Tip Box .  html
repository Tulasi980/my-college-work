<!DOCTYPE html>
<html>
<head><title>Crime Hotspot Live</title>
<style>
body{background:#fdf2f2;text-align:center;font-family:Arial}
.card{background:#fff;padding:20px;margin:20px auto;max-width:650px;border-radius:12px;box-shadow:0 2px 10px #ddd}
.input{width:75%;padding:10px;margin:8px;border:1px solid #e74c3c;border-radius:8px}
.btn{background:#c0392b;color:#fff;padding:10px 25px;border:none;border-radius:8px}
.mytable{width:100%;border-collapse:collapse;margin-top:10px}
th{background:#c0392b;color:#fff;padding:10px}
td{padding:10px;border-bottom:1px solid #eee}
.red{color:#c0392b;font-weight:bold}
.green{color:#27ae60}
</style>
</head>
<body>

<h2 style="color:#c0392b"> Crime Hotspot Live</h2>
<p>Report in 3 taps - type, location</p>

<div class="card">
<form method="POST">
<input class="input" name="type" placeholder="Type - theft / eve-teasing / fight" required><br>
<input class="input" name="lat" placeholder="Lat 16.5062" value="16.5062" required><br>
<input class="input" name="lon" placeholder="Lon 80.6480" value="80.6480" required><br><br>
<button class="btn">Report</button>
</form>
</div>

<div class="card">
<h3 style="color:#c0392b">Live Reports</h3>
<table class="mytable">
<tr><th>Type</th><th>Lat</th><th>Lon</th><th>Time</th><th>Hotspot?</th></tr>
{% for type, lat, lon, time, hotspot in rows %}
<tr>
<td>{{type}}</td>
<td>{{lat}}</td>
<td>{{lon}}</td>
<td>{{time}}</td>
<td class="{{'red' if 'RED' in hotspot else 'green'}}">{{hotspot}}</td>
</tr>
{% endfor %}
</table>
<p style="color:#777;margin-top:15px"><b>Novelty:</b> Auto hotspot if 3+ reports within 500m in last 1 hour</p>
</div>

</body>
</html>
